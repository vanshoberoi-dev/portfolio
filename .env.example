# Gemini API Key for AI Chatbot
# Get your API key from: https://makersuite.google.com/app/apikey
# For local development (Vite requires VITE_ prefix)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# For Vercel deployment: Add GEMINI_API_KEY (without VITE_ prefix) in Vercel dashboard
# The code will automatically use GEMINI_API_KEY if VITE_GEMINI_API_KEY is not found

# Google Analytics (Optional)
VITE_GA_MEASUREMENT_ID=your_ga_id_here

# Microsoft Clarity (Optional)
VITE_CLARITY_PROJECT_ID=your_clarity_id_here

